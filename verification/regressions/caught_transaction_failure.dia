app Storage:
  database SQLite
  provides DbRead<Notes>, DbWrite<Notes>

type NoteId = Id<"note">

type Note:
  id: NoteId
  title: Text
  visible: Bool = true

type NewNote:
  title: Text<length: 1..120>

resource Notes: Note

policy Notes:
  read(note, by principal):
    note.visible
  create(proposed, by principal):
    true
  update(before, after, by principal):
    before.visible and after.visible
  delete(note, by principal):
    note.visible

fn main() -> Result<Int, DataError>:
  transaction db:
    let saved = notes.create(NewNote(title: "Must roll back"))?
    let result = notes.get(NoteId("missing"))
    let recovered = match result:
      Ok(_) => 1
      Err(_) => 0
    Ok(recovered)
