export component App:
  state draft: Text = "valid"
  on save(value: Data):
    draft = value.title
  html:
    <form schema="Data" as="value" on-submit={save(value)}><field name="title" label="Title" bind-value={draft}></field><submit label="Save"></submit></form><p id="diamond-control-root%2F1%2F0">Unrelated</p>
