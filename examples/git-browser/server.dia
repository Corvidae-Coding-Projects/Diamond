  delete(row, by principal):
    principal.is_user(row.author) or principal.is_related("OrganizationOwnership", row.organization)

policy ReviewThreads:
  read(row, by principal):
    row.public or principal.is_related("OrganizationOwnership", row.organization) or principal.is_related("Membership", row.organization) or principal.is_related("TeamAccess", row.repository) or principal.is_related("RepositoryPermission", row.repository)
  create(row, by principal):
    principal.is_user(row.author) and (principal.is_related("OrganizationOwnership", row.organization) or principal.is_related("Membership", row.organization) or principal.is_related("TeamAccess", row.repository) or principal.is_related("RepositoryPermission", row.repository))
  update(before, after, by principal):
    before.id == after.id and before.organization == after.organization and before.repository == after.repository and before.merge_request == after.merge_request and before.author == after.author and before.public == after.public and before.body == after.body and (principal.is_user(before.author) or principal.is_related("OrganizationOwnership", before.organization) or principal.has_role_in("Membership", before.organization, .Maintainer) or principal.has_role_in("Membership", before.organization, .Developer) or principal.has_role_in("TeamAccess", before.repository, .Maintainer) or principal.has_role_in("TeamAccess", before.repository, .Developer) or principal.has_role_in("RepositoryPermission", before.repository, .Maintainer) or principal.has_role_in("RepositoryPermission", before.repository, .Developer))
  delete(row, by principal):
