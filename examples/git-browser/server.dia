  update(before, after, by principal):
    before.id == after.id and before.organization == after.organization and before.repository == after.repository and before.issue == after.issue and before.owner == after.owner and (principal.is_related("OrganizationOwnership", before.organization) or principal.has_role_in("Membership", before.organization, .Maintainer) or principal.has_role_in("Membership", before.organization, .Developer) or principal.has_role_in("TeamAccess", before.repository, .Maintainer) or principal.has_role_in("TeamAccess", before.repository, .Developer) or principal.has_role_in("RepositoryPermission", before.repository, .Maintainer) or principal.has_role_in("RepositoryPermission", before.repository, .Developer))
  delete(row, by principal):
    principal.is_user(row.owner) or principal.is_related("OrganizationOwnership", row.organization)

policy WikiPages:
