  host.ops_command("control", "promotion_schedule", repository, shard, object, dedup, generation)

export fn record_backup(backup: Text, state: Text, digest: Text, generation: Int) -> Result<Text, DataError>:
  host.ops_command("control", "backup_record", backup, state, digest, "", generation)

export fn record_restore(restore: Text, backup: Text, state: Text, details: Text) -> Result<Text, DataError>:
  host.ops_command("control", "restore_record", restore, backup, state, details, 0)

export fn set_operations_policy(key: Text, value: Text, generation: Int) -> Result<Text, DataError>:
  host.ops_command("control", "policy_set", key, value, "", "", generation)
