type UserId = Id<"user">
type OrganizationId = Id<"organization">
type MemberId = Id<"member">
type RepositoryId = Id<"repository">
type IssueId = Id<"issue">
type CommentId = Id<"comment">
type MergeRequestId = Id<"merge_request">
type ReviewId = Id<"review">
type TeamId = Id<"team">
type TeamMemberId = Id<"team_member">
type RepositoryGrantId = Id<"repository_grant">
type ForkId = Id<"fork">
type MilestoneId = Id<"milestone">
type LabelId = Id<"label">
type IssueLabelId = Id<"issue_label">
type IssueAssigneeId = Id<"issue_assignee">
