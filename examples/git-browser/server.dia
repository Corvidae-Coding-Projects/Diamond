  organization: OrganizationId
  repository: RepositoryId
  public: Bool
  title: Text<length: 1..160>
  body: Text<length: 0..16000>
  source_reference: Text<length: 12..255>
  target_reference: Text<length: 12..255>
  source_object: Text<length: 40..64>
  target_object: Text<length: 40..64>
  state: MergeState
  approvals: Int
  discussions_resolved: Bool
  strategy: MergeStrategy
  merged_object: Option<Text>
  rank: Int

type NewMergeRequest:
  organization: OrganizationId
  repository: RepositoryId
  public: Bool
  title: Text<length: 1..160>
  body: Text<length: 0..16000>
  source_reference: Text<length: 12..255>
  target_reference: Text<length: 12..255>
  source_object: Text<length: 40..64>
  target_object: Text<length: 40..64>
  state: MergeState
  approvals: Int
  discussions_resolved: Bool
  strategy: MergeStrategy
  merged_object: Option<Text>
