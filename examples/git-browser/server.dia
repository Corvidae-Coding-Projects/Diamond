type NotificationPreferenceId = Id<"notification_preference">
type ReleaseId = Id<"release">
type WebhookId = Id<"webhook">
type AuditEventId = Id<"audit_event">

enum IssueState:
  IssueOpen
  IssueClosed

enum MergeState:
  MergeOpen
  MergeMerged
  MergeClosed

type Organization:
  id: OrganizationId
  owner: UserId @created_by_principal
  name: Text<length: 1..80>

type NewOrganization:
  name: Text<length: 1..80>

type Member:
  id: MemberId
  organization: OrganizationId
  user: UserId
  role: MemberRole

type NewMember:
  organization: OrganizationId
  user: UserId
  role: MemberRole

type Repository:
  id: RepositoryId
  owner: UserId @created_by_principal
