policy IssueAssignees:
  read(row, by principal):
    principal.is_user(row.user) or principal.is_related("OrganizationOwnership", row.organization) or principal.is_related("Membership", row.organization) or principal.is_related("TeamAccess", row.repository) or principal.is_related("RepositoryPermission", row.repository)
  create(row, by principal):
    principal.is_user(row.owner) and (principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer) or principal.has_role_in("Membership", row.organization, .Developer) or principal.has_role_in("TeamAccess", row.repository, .Maintainer) or principal.has_role_in("TeamAccess", row.repository, .Developer) or principal.has_role_in("RepositoryPermission", row.repository, .Maintainer) or principal.has_role_in("RepositoryPermission", row.repository, .Developer))
  delete(row, by principal):
    principal.is_user(row.owner) or principal.is_related("OrganizationOwnership", row.organization)

policy BoardColumns:
