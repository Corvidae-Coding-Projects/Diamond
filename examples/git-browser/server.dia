export fn record_gate(repository: Text, reference: Text, object: Text, approvals: Int, pipeline_succeeded: Bool, discussions_resolved: Bool) -> Result<Text, DataError>:
  host.git_gate("repos", repository, reference, object, approvals, pipeline_succeeded, discussions_resolved, 86400)

