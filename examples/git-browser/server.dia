policy Organizations:
  read(row, by principal):
    principal.is_user(row.owner) or principal.is_related("Membership", row.id)
  create(row, by principal):
    principal.is_user(row.owner)
  update(before, after, by principal):
    before.id == after.id and before.owner == after.owner and principal.is_user(before.owner)
  delete(row, by principal):
    principal.is_user(row.owner)

policy Members:
  read(row, by principal):
    principal.is_user(row.user) or principal.is_related("OrganizationOwnership", row.organization)
  create(row, by principal):
    principal.is_related("OrganizationOwnership", row.organization)
  delete(row, by principal):
    principal.is_related("OrganizationOwnership", row.organization)

policy Repositories:
  read(row, by principal):
    row.public or principal.is_related("OrganizationOwnership", row.organization) or principal.is_related("Membership", row.organization) or principal.is_related("TeamAccess", row.id) or principal.is_related("RepositoryPermission", row.id)
  create(row, by principal):
    principal.is_user(row.owner) and (principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer))
  update(before, after, by principal):
    before.id == after.id and before.organization == after.organization and before.owner == after.owner and (principal.is_related("OrganizationOwnership", before.organization) or principal.has_role_in("Membership", before.organization, .Maintainer) or principal.has_role_in("Membership", before.organization, .Developer) or principal.has_role_in("TeamAccess", before.id, .Maintainer) or principal.has_role_in("TeamAccess", before.id, .Developer) or principal.has_role_in("RepositoryPermission", before.id, .Maintainer) or principal.has_role_in("RepositoryPermission", before.id, .Developer))
  delete(row, by principal):
    principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer) or principal.has_role_in("TeamAccess", row.id, .Maintainer) or principal.has_role_in("RepositoryPermission", row.id, .Maintainer)

policy Issues:
  read(row, by principal):
    row.public or principal.is_related("OrganizationOwnership", row.organization) or principal.is_related("Membership", row.organization) or principal.is_related("TeamAccess", row.repository) or principal.is_related("RepositoryPermission", row.repository)
  create(row, by principal):
    principal.is_user(row.author) and (principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer) or principal.has_role_in("Membership", row.organization, .Developer) or principal.has_role_in("TeamAccess", row.repository, .Maintainer) or principal.has_role_in("TeamAccess", row.repository, .Developer) or principal.has_role_in("RepositoryPermission", row.repository, .Maintainer) or principal.has_role_in("RepositoryPermission", row.repository, .Developer))
  update(before, after, by principal):
    before.organization == after.organization and before.repository == after.repository and before.author == after.author and before.public == after.public and (principal.is_user(before.author) or principal.is_related("OrganizationOwnership", before.organization) or principal.has_role_in("Membership", before.organization, .Maintainer) or principal.has_role_in("Membership", before.organization, .Developer))
  delete(row, by principal):
    principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer) or principal.has_role_in("Membership", row.organization, .Developer)

policy Comments:
  read(row, by principal):
    row.public or principal.is_related("OrganizationOwnership", row.organization) or principal.is_related("Membership", row.organization) or principal.is_related("TeamAccess", row.repository) or principal.is_related("RepositoryPermission", row.repository)
  create(row, by principal):
    principal.is_user(row.author) and (principal.is_related("OrganizationOwnership", row.organization) or principal.is_related("Membership", row.organization) or principal.is_related("TeamAccess", row.repository) or principal.is_related("RepositoryPermission", row.repository))
  delete(row, by principal):
    principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer) or (principal.is_user(row.author) and principal.is_related("Membership", row.organization))

policy MergeRequests:
  read(row, by principal):
    row.public or principal.is_related("OrganizationOwnership", row.organization) or principal.is_related("Membership", row.organization) or principal.is_related("TeamAccess", row.repository) or principal.is_related("RepositoryPermission", row.repository)
  create(row, by principal):
    principal.is_user(row.author) and (principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer) or principal.has_role_in("Membership", row.organization, .Developer) or principal.has_role_in("TeamAccess", row.repository, .Maintainer) or principal.has_role_in("TeamAccess", row.repository, .Developer) or principal.has_role_in("RepositoryPermission", row.repository, .Maintainer) or principal.has_role_in("RepositoryPermission", row.repository, .Developer))
  update(before, after, by principal):
    before.organization == after.organization and before.repository == after.repository and before.author == after.author and before.public == after.public and before.title == after.title and before.body == after.body and before.source_reference == after.source_reference and before.target_reference == after.target_reference and before.source_object == after.source_object and before.target_object == after.target_object and before.strategy == after.strategy and (principal.is_related("OrganizationOwnership", before.organization) or principal.has_role_in("Membership", before.organization, .Maintainer) or principal.has_role_in("Membership", before.organization, .Developer) or principal.has_role_in("TeamAccess", before.repository, .Maintainer) or principal.has_role_in("TeamAccess", before.repository, .Developer) or principal.has_role_in("RepositoryPermission", before.repository, .Maintainer) or principal.has_role_in("RepositoryPermission", before.repository, .Developer))
  delete(row, by principal):
    principal.is_related("OrganizationOwnership", row.organization) or (principal.is_user(row.author) and principal.is_related("Membership", row.organization))

policy Reviews:
  read(row, by principal):
    principal.is_related("OrganizationOwnership", row.organization) or principal.is_related("Membership", row.organization) or principal.is_related("TeamAccess", row.repository) or principal.is_related("RepositoryPermission", row.repository)
  create(row, by principal):
    principal.is_user(row.reviewer) and row.reviewer != row.author and (principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer) or principal.has_role_in("Membership", row.organization, .Developer) or principal.has_role_in("TeamAccess", row.repository, .Maintainer) or principal.has_role_in("TeamAccess", row.repository, .Developer) or principal.has_role_in("RepositoryPermission", row.repository, .Maintainer) or principal.has_role_in("RepositoryPermission", row.repository, .Developer))
  delete(row, by principal):
    principal.is_user(row.reviewer) or principal.is_related("OrganizationOwnership", row.organization)

policy Teams:
  read(row, by principal):
    principal.is_related("OrganizationOwnership", row.organization) or principal.is_related("Membership", row.organization)
  create(row, by principal):
    principal.is_user(row.owner) and (principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer))
  update(before, after, by principal):
    before.id == after.id and before.organization == after.organization and before.owner == after.owner and (principal.is_related("OrganizationOwnership", before.organization) or principal.has_role_in("Membership", before.organization, .Maintainer))
  delete(row, by principal):
    principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer)

policy TeamMembers:
  read(row, by principal):
    principal.is_user(row.user) or principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer)
  create(row, by principal):
    principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer)
  delete(row, by principal):
    principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer)

policy RepositoryGrants:
  read(row, by principal):
    principal.is_user(row.user) or principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer)
  create(row, by principal):
    principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer)
  delete(row, by principal):
    principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer)

policy Forks:
  read(row, by principal):
    row.public or principal.is_user(row.owner) or principal.is_related("OrganizationOwnership", row.organization) or principal.is_related("Membership", row.organization)
  create(row, by principal):
    principal.is_user(row.owner) and (row.public or principal.is_related("OrganizationOwnership", row.organization) or principal.is_related("Membership", row.organization))
  delete(row, by principal):
    principal.is_user(row.owner) or principal.is_related("OrganizationOwnership", row.organization)

policy Milestones:
  read(row, by principal):
    row.public or principal.is_related("OrganizationOwnership", row.organization) or principal.is_related("Membership", row.organization) or principal.is_related("TeamAccess", row.repository) or principal.is_related("RepositoryPermission", row.repository)
  create(row, by principal):
    principal.is_user(row.owner) and (principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer) or principal.has_role_in("Membership", row.organization, .Developer) or principal.has_role_in("TeamAccess", row.repository, .Maintainer) or principal.has_role_in("TeamAccess", row.repository, .Developer) or principal.has_role_in("RepositoryPermission", row.repository, .Maintainer) or principal.has_role_in("RepositoryPermission", row.repository, .Developer))
  update(before, after, by principal):
    before.id == after.id and before.organization == after.organization and before.repository == after.repository and before.owner == after.owner and (principal.is_related("OrganizationOwnership", before.organization) or principal.has_role_in("Membership", before.organization, .Maintainer) or principal.has_role_in("Membership", before.organization, .Developer) or principal.has_role_in("TeamAccess", before.repository, .Maintainer) or principal.has_role_in("TeamAccess", before.repository, .Developer) or principal.has_role_in("RepositoryPermission", before.repository, .Maintainer) or principal.has_role_in("RepositoryPermission", before.repository, .Developer))
  delete(row, by principal):
    principal.is_related("OrganizationOwnership", row.organization) or principal.has_role_in("Membership", row.organization, .Maintainer)

