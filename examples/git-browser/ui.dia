export component GitForge:
  state username: Text = ""
  state password: Text = ""
  state registration_password: Text = ""
  state email: Text = ""
  state invitation: Text = ""
  state challenge: Text = ""
  state signed_in: Text = ""
  state account_status: Text = "Use a local account or continue with Google or GitHub."
  state organization_name: Text = "example-team"
  state organization: Text = ""
  state organizations: List<OrganizationCard> = []
  state member_user: Text = ""
  state member_id: Text = ""
  state repository_name: Text = "example"
  state repository_description: Text = "A repository hosted by Diamond Forge."
  state repository_public: Bool = true
  state repository: Text = ""
  state repositories: RepositoryPage = RepositoryPage(cards: [], after: "", total: 0)
  state credential: Text = ""
  state head: GitHead = GitHead(reference: "", object: None)
  state revision: Text = "refs/heads/main"
  state path: Text = ""
  state old_revision: Text = "refs/heads/main~1"
  state tree: GitTree = GitTree(revision: "", path: "", entries: [], truncated: false)
  state blob: GitBlob = GitBlob(revision: "", path: "", object: "", size: "0", text: "")
  state history: GitHistory = GitHistory(revision: "0000000000000000000000000000000000000000", commits: [])
  state diff: GitDiff = GitDiff(old: "", new: "", text: "")
  state issue_title: Text = ""
  state issue_body: Text = ""
  state issue: Text = ""
  state issue_detail: IssueDetail = IssueDetail(id: "", title: "", body: "", state: "", author: "")
  state issues: IssuePage = IssuePage(cards: [], after: "", total: 0)
  state issue_comments: List<CommentCard> = []
  state comment_body: Text = ""
  state attachment: Option<Blob<"issue_attachments">> = None
  state attachment_status: Text = ""
  state merge_title: Text = ""
  state merge_body: Text = ""
  state merge_request: Text = ""
  state source_reference: Text = "refs/heads/feature"
  state target_reference: Text = "refs/heads/main"
  state merge_requests: MergeRequestPage = MergeRequestPage(cards: [], after: "", total: 0)
  state selected_merge: MergeRequestCard = MergeRequestCard(id: "", title: "", state: "", source_reference: "", target_reference: "", source_object: "", target_object: "", approvals: 0, author: "", strategy: "")
  state merge_plan: MergePlan = MergePlan(merge_request: "", repository: "", source_reference: "", target_reference: "", source_object: "", target_object: "")
  state protected_reference: Text = "refs/heads/main"
  state deploy_label: Text = "automation"
  state deploy_key: Text = ""
  state deploy_id: Text = ""
  state push_events: Text = ""
  state push_event_id: Text = ""
  state team_name: Text = "platform"
  state team: Text = ""
  state team_member: Text = ""
  state repository_grant: Text = ""
  state permission_user: Text = ""
  state fork_name: Text = "fork"
  state fork: Text = ""
  state milestone_title: Text = "Next milestone"
  state milestone_due: Text = ""
  state milestone: Text = ""
  state label_name: Text = "feature"
  state label_color: Text = "2563eb"
  state label: Text = ""
  state assignee: Text = ""
  state board_column_title: Text = "Backlog"
  state board_column: Text = ""
  state board_card: Text = ""
  state wiki_page: Text = ""
  state wiki_slug: Text = "home"
  state wiki_title: Text = "Home"
  state wiki_body: Text = "Project knowledge starts here."
  state snippet_title: Text = "Example"
  state snippet_filename: Text = "example.txt"
  state snippet_body: Text = ""
  state snippet: Text = ""
  state review_thread: Text = ""
  state review_thread_body: Text = "Please address this before merging."
  state review_id: Text = ""
  state merge_message: Text = "Merge reviewed changes"
  state integrated_object: Text = ""
  state notification: Text = ""
  state notification_preference: NotificationPreferenceCard = NotificationPreferenceCard(id: "", enabled: true, unread_only: false)
  state notifications_enabled: Bool = true
  state notifications_unread_only: Bool = false
  state release: Text = ""
  state release_tag: Text = "refs/tags/v0.1.0"
  state release_name: Text = "v0.1.0"
  state release_notes: Text = "Release notes"
  state release_draft: Bool = false
  state release_asset: Option<Blob<"release_assets">> = None
  state release_asset_status: Text = ""
  state pipeline: Text = ""
  state pipeline_event: Text = "manual-1"
  state pipeline_reference: Text = "refs/heads/main"
  state pipelines: PipelineResults = PipelineResults(cards: [])
  state pipeline_jobs: JobResults = JobResults(cards: [])
  state pipeline_artifacts: ArtifactResults = ArtifactResults(cards: [])
  state artifact_id: Text = ""
  state pipeline_images: ImageResults = ImageResults(cards: [])
  state pipeline_pages: PageResults = PageResults(cards: [])
  state page_site: Text = "docs"
  state page_deployment: Text = ""
  state page_domain: Text = "docs.example.test"
  state page_domains: DomainResults = DomainResults(cards: [])
  state pipeline_environments: EnvironmentResults = EnvironmentResults(cards: [])
  state environment_name: Text = ""
  state webhook: Text = ""
  state webhook_path: Text = "/hooks/diamond"
  state webhook_event: Text = "manual-test"
  state webhook_payload: Text = "{}"
  state dashboard: CollaborationDashboard = CollaborationDashboard(teams: [], team_permissions: [], direct_permissions: [], forks: [], milestones: [], labels: [], columns: [], cards: [], wiki: [], snippets: [], threads: [], reviews: [], notifications: [], releases: [], webhooks: [], audit: [])
  state activity: Text = "Waiting for repository activity."
  state activity_cursor: Text = "0"
  state output: Text = "Sign in, create an organization, then create a repository."
  derived repository_total: Text = int_text(repositories.total) + " visible repositories"
  derived issue_total: Text = int_text(issues.total) + " visible issues"
  derived merge_total: Text = int_text(merge_requests.total) + " visible merge requests"

  on sign_in:
    signed_in = session.login(username, password)
    password = ""
    credential = ""
    organizations = rpc.organizations_list()
    output = "Signed in. Choose an organization to continue."
  on sign_out:
    signed_in = session.logout()
    credential = ""
    organization = ""
    repository = ""
    issue = ""
    merge_request = ""
    organizations = []
    repositories = RepositoryPage(cards: [], after: "", total: 0)
    output = "Signed out."
  on register:
    account_status = session.register(username, email, registration_password, invitation)
    registration_password = ""
    invitation = ""
  on verify:
    account_status = session.verify(challenge)
    challenge = ""
  on google_login:
    account_status = session.oauth_login("google", invitation)
  on github_login:
    account_status = session.oauth_login("github", invitation)
  on create_organization:
    organization = rpc.create_organization(organization_name)
    organizations = rpc.organizations_list()
    output = "Organization created."
  on load_organizations:
    organizations = rpc.organizations_list()
    output = "Organization list refreshed."
  on choose_organization:
    repository = ""
    issue = ""
    merge_request = ""
    repositories = rpc.repository_page(organization, "")
    output = "Choose a repository, then open its workspace."
  on grant_maintainer:
    member_id = rpc.grant_maintainer(organization, member_user)
    output = "Maintainer granted."
  on grant_developer:
    member_id = rpc.grant_developer(organization, member_user)
    output = "Developer granted."
  on grant_reporter:
    member_id = rpc.grant_reporter(organization, member_user)
    output = "Reporter granted."
  on revoke_member:
    output = rpc.revoke_member(member_id)
  on create_repository:
    repository = rpc.create_repository(organization, repository_name, repository_description, repository_public)
    repositories = rpc.repository_page(organization, "")
    output = "Repository metadata created. Initialize Git before pushing."
  on initialize_repository:
    output = rpc.initialize_repository(repository)
  on load_repositories:
    repositories = rpc.repository_page(organization, "")
    output = "Repository list refreshed."
  on next_repositories:
    repositories = rpc.repository_page(organization, repositories.after)
  on open_repository:
    issues = rpc.issue_page(organization, repository, "")
    merge_requests = rpc.merge_request_page(organization, repository, "")
    dashboard = rpc.collaboration_dashboard(organization, repository)
    pipelines = rpc.delivery_pipelines(repository)
    output = "Repository workspace loaded."
  on create_credential:
    credential = session.create_token("Git client", ["git:repos:read", "git:repos:write"], "{\"repository\":[\"" + repository + "\"]}", 3600)
    output = "Copy this one-hour credential now."
  on load_head:
    head = rpc.repository_head(repository)
  on load_tree:
    tree = rpc.repository_tree(repository, revision, path)
  on load_blob:
    blob = rpc.repository_blob(repository, revision, path)
  on load_history:
    history = rpc.repository_history(repository, revision)
  on load_diff:
    diff = rpc.repository_diff(repository, old_revision, revision)
  on create_issue:
    issue = rpc.create_issue(repository, issue_title, issue_body)
    issue_detail = rpc.read_issue(issue)
    issues = rpc.issue_page(organization, repository, "")
  on load_issues:
    issues = rpc.issue_page(organization, repository, "")
  on next_issues:
    issues = rpc.issue_page(organization, repository, issues.after)
  on read_issue:
    issue_detail = rpc.read_issue(issue)
    issue_title = issue_detail.title
    issue_body = issue_detail.body
    issue_comments = rpc.issue_comments(organization, repository, issue)
  on edit_issue:
    issue_detail = rpc.edit_issue(issue, issue_title, issue_body)
    issues = rpc.issue_page(organization, repository, "")
  on close_issue:
    issue_detail = rpc.close_issue(issue)
    issues = rpc.issue_page(organization, repository, "")
  on add_comment:
    output = rpc.add_issue_comment(issue, comment_body)
    comment_body = ""
    issue_comments = rpc.issue_comments(organization, repository, issue)
  on load_comments:
    issue_comments = rpc.issue_comments(organization, repository, issue)
  on upload_attachment:
    attachment = Some(files.upload("issue_attachments", issue, "issue_attachment"))
    attachment_status = "Upload complete."
  on download_attachment:
    attachment = match attachment:
      Some(file) => Some(files.download("issue_attachments", file))
      None => None
  on delete_attachment:
    attachment = match attachment:
      Some(file) => files.delete("issue_attachments", file)
      None => None
    attachment_status = "Attachment deleted."
  on create_merge_request:
    merge_request = rpc.create_merge_request(repository, merge_title, merge_body, source_reference, target_reference)
    selected_merge = rpc.read_merge_request(merge_request)
    merge_requests = rpc.merge_request_page(organization, repository, "")
  on load_merge_requests:
    merge_requests = rpc.merge_request_page(organization, repository, "")
  on next_merge_requests:
    merge_requests = rpc.merge_request_page(organization, repository, merge_requests.after)
  on read_merge_request:
    selected_merge = rpc.read_merge_request(merge_request)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on approve_merge_request:
    selected_merge = rpc.approve_merge_request(merge_request)
  on resolve_discussions:
    selected_merge = rpc.resolve_merge_discussions(merge_request)
  on merge_selected:
    output = rpc.merge_approved_request(merge_request, "")
    selected_merge = rpc.finalize_approved_request(merge_request, output)
    merge_requests = rpc.merge_request_page(organization, repository, "")
    output = "Merge completed at " + output
  on close_merge_request:
    selected_merge = rpc.close_merge_request(merge_request)
    merge_requests = rpc.merge_request_page(organization, repository, "")
  on protect_main:
    output = rpc.protect_reference(repository, protected_reference, "authenticated", false, false, 1, false, true, false, false)
  on unprotect_main:
    output = rpc.unprotect_reference(repository, protected_reference)
  on add_deploy_key:
    deploy_id = rpc.add_deploy_key(repository, deploy_label, deploy_key, false)
    deploy_key = ""
    output = "Read-only deploy key added."
  on revoke_deploy_key:
    output = rpc.revoke_deploy_key(repository, deploy_id)
  on load_push_events:
    push_events = rpc.pending_push_events(100)
  on acknowledge_push_event:
    output = rpc.acknowledge_push_event(push_event_id)
  on refresh_collaboration:
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on create_team:
    team = rpc.create_team(organization, team_name)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on add_team_developer:
    team_member = rpc.add_team_member(team, repository, permission_user, Developer)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on add_team_reporter:
    team_member = rpc.add_team_member(team, repository, permission_user, Reporter)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on revoke_team_permission:
    output = rpc.revoke_team_member(team_member)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on grant_repository_developer:
    repository_grant = rpc.grant_repository_permission(repository, permission_user, Developer)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on grant_repository_reporter:
    repository_grant = rpc.grant_repository_permission(repository, permission_user, Reporter)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on revoke_repository_permission:
    output = rpc.revoke_repository_permission(repository_grant)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on create_fork:
    fork = rpc.create_fork_metadata(repository, organization, fork_name, "Forked through Diamond Forge", repository_public)
    output = rpc.initialize_fork(fork)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on create_milestone:
    milestone = rpc.create_milestone(repository, milestone_title, milestone_due)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on create_label:
    label = rpc.create_label(repository, label_name, label_color)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on label_issue:
    output = rpc.label_issue(issue, label)
  on assign_issue:
    output = rpc.assign_issue(issue, assignee)
  on reopen_issue:
    issue_detail = rpc.reopen_issue(issue)
    issues = rpc.issue_page(organization, repository, "")
  on create_board_column:
    board_column = rpc.create_board_column(repository, board_column_title)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on add_board_card:
    board_card = rpc.add_board_card(issue, board_column)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on move_board_card:
    board_card = rpc.move_issue_board_card(issue, board_column)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on create_wiki_page:
    wiki_page = rpc.create_wiki_page(repository, wiki_slug, wiki_title, wiki_body)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on update_wiki_page:
    wiki_page = rpc.update_wiki_page(wiki_page, wiki_title, wiki_body)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on create_snippet:
    snippet = rpc.create_snippet(repository, snippet_title, snippet_filename, snippet_body)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on add_review_thread:
    review_thread = rpc.add_review_thread(merge_request, review_thread_body)
    selected_merge = rpc.read_merge_request(merge_request)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on resolve_review_thread:
    review_thread = rpc.resolve_review_thread(review_thread)
    selected_merge = rpc.read_merge_request(merge_request)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on dismiss_approval:
    selected_merge = rpc.dismiss_approval(review_id)
  on create_squash_merge_request:
    merge_request = rpc.create_merge_request_strategy(repository, merge_title, merge_body, source_reference, target_reference, Squash)
    selected_merge = rpc.read_merge_request(merge_request)
  on create_merge_commit_request:
    merge_request = rpc.create_merge_request_strategy(repository, merge_title, merge_body, source_reference, target_reference, MergeCommit)
    selected_merge = rpc.read_merge_request(merge_request)
  on merge_squash:
    integrated_object = rpc.merge_approved_request(merge_request, merge_message)
    selected_merge = rpc.finalize_approved_request(merge_request, integrated_object)
  on merge_commit:
    integrated_object = rpc.merge_approved_request(merge_request, merge_message)
    selected_merge = rpc.finalize_approved_request(merge_request, integrated_object)
  on mark_notification_read:
    notification = rpc.mark_notification_read(notification)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on load_notification_preferences:
    notification_preference = rpc.notification_preferences(repository)
    notifications_enabled = notification_preference.enabled
    notifications_unread_only = notification_preference.unread_only
  on save_notification_preferences:
    notification_preference = rpc.save_notification_preferences(repository, notifications_enabled, notifications_unread_only)
    dashboard = rpc.collaboration_dashboard(organization, repository)
    output = "Notification preferences saved."
  on create_release:
    release = rpc.create_release(repository, release_tag, release_name, release_notes, release_draft)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on schedule_pipeline:
    pipeline = rpc.schedule_pipeline(repository, pipeline_reference, pipeline_event)
    pipelines = rpc.delivery_pipelines(repository)
    output = "Pipeline scheduled from the immutable Git commit."
  on refresh_delivery:
    pipelines = rpc.delivery_pipelines(repository)
    pipeline_jobs = rpc.delivery_jobs(repository, pipeline)
    pipeline_artifacts = rpc.delivery_artifacts(repository, pipeline)
    pipeline_images = rpc.delivery_images(repository)
    pipeline_pages = rpc.delivery_pages(repository)
    page_domains = rpc.delivery_domains(repository)
    pipeline_environments = rpc.delivery_environments(repository)
  on delete_delivery_artifact:
    artifact_id = rpc.delete_delivery_artifact(repository, artifact_id)
    pipeline_artifacts = rpc.delivery_artifacts(repository, pipeline)
    output = "Artifact metadata deleted; unreferenced bytes are reclaimed by bounded GC."
  on activate_pages_deployment:
    page_deployment = rpc.activate_pages_deployment(repository, page_site, page_deployment)
    pipeline_pages = rpc.delivery_pages(repository)
    output = "Pages deployment activated."
  on set_pages_domain:
    page_domain = rpc.set_pages_domain(repository, page_domain, page_site)
    page_domains = rpc.delivery_domains(repository)
    output = "Custom domain activated by an account administrator."
  on remove_pages_domain:
    page_domain = rpc.remove_pages_domain(repository, page_domain)
    page_domains = rpc.delivery_domains(repository)
    output = "Custom domain removed."
  on stop_delivery_environment:
    environment_name = rpc.stop_delivery_environment(repository, environment_name)
    pipeline_environments = rpc.delivery_environments(repository)
    output = "Environment stopped."
  on cancel_pipeline:
    output = rpc.cancel_pipeline(repository, pipeline)
    pipelines = rpc.delivery_pipelines(repository)
  on upload_release_asset:
    release_asset = Some(files.upload("release_assets", release, "release_asset_file"))
    release_asset_status = "Upload complete."
  on download_release_asset:
    release_asset = match release_asset:
      Some(file) => Some(files.download("release_assets", file))
      None => None
  on delete_release_asset:
    release_asset = match release_asset:
      Some(file) => files.delete("release_assets", file)
      None => None
    release_asset_status = "Release asset deleted."
  on create_webhook:
    webhook = rpc.create_webhook(repository, webhook_path)
    dashboard = rpc.collaboration_dashboard(organization, repository)
  on test_webhook:
    output = rpc.deliver_webhook(webhook, webhook_event, webhook_payload)

  html:
    <main id="main-content">
      <a class="skip-link" href="#page-content">Skip to content</a>
      <header class="app-header"><a class="brand" href="/"><span class="brand-mark">◆</span><span>Diamond Forge</span></a><when test={signed_in != ""}><div class="account-chip"><span>Signed in as</span><strong>{signed_in}</strong><button class="quiet compact" type="button" on-click={sign_out}>Sign out</button></div></when></header>
      <when test={signed_in == ""}>
        <section class="welcome" aria-labelledby="welcome-heading"><div class="welcome-copy"><p class="eyebrow">SECURE GIT COLLABORATION</p><h1 id="welcome-heading">Ship code with less friction.</h1><p>Repositories, issues, reviews, releases, and CI share one checked permission model.</p></div><div class="auth-shell"><section class="auth-card" aria-labelledby="signin-heading"><h2 id="signin-heading">Sign in</h2><p class="helper">Use your work account or a local Diamond Forge account.</p><div class="oauth-actions"><button type="button" on-click={google_login}>Continue with Google</button><button class="secondary" type="button" on-click={github_login}>Continue with GitHub</button></div><p class="divider"><span>or use a local account</span></p><form class="stack" on-submit={sign_in}><label for="username">Username</label><input id="username" autocomplete="username" required="true" bind-value={username}><label for="password">Password</label><input id="password" type="password" autocomplete="current-password" required="true" bind-value={password}><button type="submit" disabled={pending}>Sign in</button></form></section><section class="auth-card subdued" aria-labelledby="register-heading"><h2 id="register-heading">Create an account</h2><p class="helper">Your administrator may require an approved email or invite code.</p><form class="stack" on-submit={register}><label for="email">Email</label><input id="email" autocomplete="email" required="true" bind-value={email}><label for="registration-password">Create password</label><input id="registration-password" type="password" autocomplete="new-password" required="true" bind-value={registration_password}><label for="invitation">Invite code <span class="optional">optional</span></label><input id="invitation" type="password" autocomplete="one-time-code" bind-value={invitation}><button class="secondary" type="submit" disabled={pending}>Create account</button></form><hr><form class="verify-row" on-submit={verify}><div><label for="challenge">Verification code</label><input id="challenge" type="password" autocomplete="one-time-code" bind-value={challenge}></div><button class="quiet" type="submit" disabled={pending}>Verify</button></form><p role="status" aria-live="polite">{account_status}</p></section></div></section>
      </when>
      <when test={signed_in != ""}>
        <section class="workspace-bar" aria-labelledby="workspace-heading"><div><p class="eyebrow">CURRENT WORKSPACE</p><h2 id="workspace-heading">Choose where you want to work</h2></div><div class="workspace-controls"><div><label for="organization-picker">Organization</label><select id="organization-picker" bind-value={organization}><option value="">Choose an organization</option><each items={organizations} as="organization_choice" key={organization_choice.id}><option value={organization_choice.id}>{organization_choice.name}</option></each></select></div><button class="quiet align-end" type="button" on-click={choose_organization} disabled={organization == ""}>Show repositories</button><div><label for="repository-picker">Repository</label><select id="repository-picker" bind-value={repository}><option value="">Choose a repository</option><each items={repositories.cards} as="repository_choice" key={repository_choice.id}><option value={repository_choice.id}>{repository_choice.name}</option></each></select></div><button class="align-end" type="button" on-click={open_repository} disabled={repository == ""}>Open repository</button></div><when test={organization == ""}><p class="context-hint">Start by choosing an organization. You can create one on this page.</p></when><when test={organization != "" and repository == ""}><p class="context-hint">Organization selected. Show its repositories, choose one, then open it.</p></when><when test={repository != ""}><p class="context-ready"><span class="status-dot"></span>Repository ready <code>{repository}</code></p></when></section>
        <nav class="primary-nav" aria-label="Repository navigation"><div class="nav-core"><a href="/" aria-current={route == "/"}>Code</a><a href="/issues" aria-current={route == "/issues"}>Issues</a><a href="/merge-requests" aria-current={route == "/merge-requests"}>Merge requests</a><a href="/delivery" aria-current={route == "/delivery"}>CI/CD</a><a href="/activity" aria-current={route == "/activity"}>Activity</a></div><div class="nav-manage"><span>Manage</span><a href="/collaboration" aria-current={route == "/collaboration"}>Access</a><a href="/knowledge" aria-current={route == "/knowledge"}>Wiki</a><a href="/releases" aria-current={route == "/releases"}>Releases</a><a href="/settings" aria-current={route == "/settings"}>Settings</a><a href="/operations" aria-current={route == "/operations"}>Admin</a></div></nav>
        <when test={repository != ""}><watch stream={stream("repository_activity", repository)} into="activity" cursor="activity_cursor"></watch></when>
        <div class="status-stack"><when test={pending}><p class="notice" role="status">Working…</p></when><when test={error != ""}><p class="error" role="alert">{error}</p></when><p class="notice" role="status" aria-live="polite">{output}</p></div>
        <div id="page-content" class="page-content">
      <route path="/">
        <header class="page-heading"><div><p class="eyebrow">CODE</p><h1>Repositories</h1><p>Create a project, connect Git, and browse the code your team can access.</p></div><button class="quiet" type="button" on-click={load_organizations}>Refresh organizations</button></header>
        <div class="content-grid">
          <section class="panel" aria-labelledby="organization-heading"><div class="section-heading"><div><h2 id="organization-heading">Organizations</h2><p>Organizations own repositories and team access.</p></div><span class="count">{len(organizations)}</span></div><form class="inline-form" on-submit={create_organization}><div><label for="organization-name">New organization name</label><input id="organization-name" minlength="1" maxlength="80" required="true" bind-value={organization_name}></div><button type="submit" disabled={pending}>Create organization</button></form><when test={len(organizations) == 0}><p class="empty-state">No organizations yet. Create your first one above.</p></when><ul class="cards"><each items={organizations} as="organization_card" key={organization_card.id}><li><strong>{organization_card.name}</strong><p class="resource-id">Organization ID <code>{organization_card.id}</code></p></li></each></ul></section>
          <section class="panel" aria-labelledby="repository-heading"><div class="section-heading"><div><h2 id="repository-heading">New repository</h2><p>Create metadata first, then initialize its Git storage.</p></div></div><when test={organization == ""}><p class="empty-state">Choose an organization before creating a repository.</p></when><form class="stack" on-submit={create_repository}><label for="repository-name">Repository name</label><input id="repository-name" minlength="1" maxlength="80" required="true" bind-value={repository_name}><label for="repository-description">Description</label><textarea id="repository-description" maxlength="500" bind-value={repository_description}></textarea><label class="check"><input id="repository-public" type="checkbox" bind-checked={repository_public}> Anyone can view this repository</label><button type="submit" disabled={organization == "" or pending}>Create repository metadata</button></form><when test={repository != ""}><div class="next-step"><strong>Next step</strong><p>Initialize Git storage before the first push. This safe second step can be retried.</p><button type="button" on-click={initialize_repository}>Initialize Git storage</button></div></when></section>
        </div>
        <section class="panel" aria-labelledby="repository-list-heading"><div class="section-heading"><div><h2 id="repository-list-heading">Available repositories</h2><p>Choose a repository in the workspace bar to use it across every page.</p></div><span class="count">{repository_total}</span></div><div class="actions"><button class="quiet" type="button" on-click={load_repositories} disabled={organization == ""}>Refresh list</button><button class="quiet" type="button" on-click={next_repositories} disabled={repositories.after == ""}>Next page</button></div><when test={organization != "" and len(repositories.cards) == 0}><p class="empty-state">No visible repositories in this organization.</p></when><ul class="cards repository-cards"><each items={repositories.cards} as="repository_card" key={repository_card.id}><li><div class="card-title"><strong>{repository_card.name}</strong><span class="badge">{repository_card.visibility}</span></div><p>{repository_card.description}</p><p class="resource-id">Repository ID <code>{repository_card.id}</code></p></li></each></ul></section>
        <when test={repository != ""}>
          <section class="panel" aria-labelledby="clone-heading"><div class="section-heading"><div><h2 id="clone-heading">Clone this repository</h2><p>Create a short-lived credential for stock Git over HTTPS.</p></div></div><pre>git clone https://forge.example.test/_diamond/git/repos/{repository}.git</pre><button type="button" on-click={create_credential}>Create one-hour Git credential</button><when test={credential != ""}><div class="secret-box" role="status"><strong>Copy this credential now</strong><p>It is shown once and limited to this repository.</p><pre class="secret">{credential}</pre></div></when></section>
          <section class="panel" aria-labelledby="browse-heading"><div class="section-heading"><div><h2 id="browse-heading">Browse code</h2><p>Use a branch, tag, or commit. Leave path empty for the repository root.</p></div></div><div class="grid"><div><label for="revision">Branch, tag, or commit</label><input id="revision" placeholder="refs/heads/main" bind-value={revision}></div><div><label for="path">File or folder path <span class="optional">optional</span></label><input id="path" placeholder="src/main.rs" bind-value={path}></div><div><label for="old-revision">Compare from</label><input id="old-revision" placeholder="refs/heads/main~1" bind-value={old_revision}></div></div><div class="actions"><button type="button" on-click={load_tree}>View files</button><button class="quiet" type="button" on-click={load_blob}>Open file</button><button class="quiet" type="button" on-click={load_history}>View commits</button><button class="quiet" type="button" on-click={load_diff}>Compare changes</button><button class="quiet" type="button" on-click={load_head}>Show default branch</button></div><when test={head.reference != ""}><p class="context-ready">Default branch <code>{head.reference}</code></p></when><ul class="tree"><each items={tree.entries} as="entry" key={entry.object + entry.name}><li><span class="badge">{entry.kind}</span><code>{entry.name}</code></li></each></ul><when test={blob.path != ""}><article class="result-block"><h3>{blob.path}</h3><p>{blob.size} bytes</p><pre>{blob.text}</pre></article></when><when test={len(history.commits) != 0}><article class="result-block"><h3>Commit history</h3><ol class="commits"><each items={history.commits} as="commit" key={commit.object}><li><strong>{commit.subject}</strong><p>{commit.author_name} · {commit.authored_at}</p><code>{commit.object}</code></li></each></ol></article></when><when test={diff.text != ""}><article class="result-block"><h3>Changes</h3><pre>{diff.text}</pre></article></when></section>
        </when>
        <section class="panel admin-panel" aria-labelledby="membership-heading"><div class="section-heading"><div><h2 id="membership-heading">Organization membership</h2><p>Administrator tools. Grant the least access a person needs.</p></div><span class="badge">Admin</span></div><div class="grid"><div><label for="member-user">User ID</label><input id="member-user" bind-value={member_user}></div><div><label for="member-id">Membership to revoke</label><input id="member-id" bind-value={member_id}></div></div><div class="actions"><button type="button" on-click={grant_maintainer} disabled={organization == ""}>Grant maintainer</button><button class="secondary" type="button" on-click={grant_developer} disabled={organization == ""}>Grant developer</button><button class="quiet" type="button" on-click={grant_reporter} disabled={organization == ""}>Grant reporter</button><button class="danger" type="button" on-click={revoke_member} disabled={member_id == ""}>Revoke selected membership</button></div></section>
      </route>
      <route path="/collaboration">
        <header class="page-heading"><div><p class="eyebrow">MANAGE</p><h1>Access and forks</h1><p>Repository access is checked on every request, so revocations take effect immediately.</p></div><button class="quiet" type="button" on-click={refresh_collaboration} disabled={repository == ""}>Refresh access</button></header>
        <when test={repository == ""}><p class="empty-state page-empty">Choose and open a repository to manage access.</p></when>
        <when test={repository != ""}><section class="panel" aria-labelledby="collaboration-heading"><h2 id="collaboration-heading">Teams and permissions</h2>
          <h3>Teams</h3><div class="grid"><div><label for="team-name">New team name</label><input id="team-name" maxlength="80" bind-value={team_name}></div><div><label for="team-id">Team</label><select id="team-id" bind-value={team}><option value="">Choose a team</option><each items={dashboard.teams} as="team_choice" key={team_choice.id}><option value={team_choice.id}>{team_choice.name}</option></each></select></div><div><label for="permission-user">User ID</label><input id="permission-user" bind-value={permission_user}></div><div><label for="team-member-id">Team permission to revoke</label><select id="team-member-id" bind-value={team_member}><option value="">Choose a permission</option><each items={dashboard.team_permissions} as="team_permission_choice" key={team_permission_choice.id}><option value={team_permission_choice.id}>{team_permission_choice.user} · {team_permission_choice.role}</option></each></select></div></div>
          <div class="actions"><button type="button" on-click={create_team}>Create team</button><button type="button" on-click={add_team_developer} disabled={team == "" or permission_user == ""}>Grant team developer</button><button class="quiet" type="button" on-click={add_team_reporter} disabled={team == "" or permission_user == ""}>Grant team reporter</button><button class="danger" type="button" on-click={revoke_team_permission} disabled={team_member == ""}>Revoke selected team permission</button></div>
          <ul class="cards"><each items={dashboard.teams} as="team_card" key={team_card.id}><li><strong>{team_card.name}</strong><code>{team_card.id}</code></li></each></ul>
          <ul class="cards"><each items={dashboard.team_permissions} as="permission" key={permission.id}><li><span class="badge">{permission.role}</span><strong>{permission.user}</strong><p>{permission.source}</p><code>{permission.id}</code></li></each></ul>
          <h3>Direct collaborators</h3><label for="repository-grant-id">Direct permission to revoke</label><select id="repository-grant-id" bind-value={repository_grant}><option value="">Choose a direct permission</option><each items={dashboard.direct_permissions} as="direct_choice" key={direct_choice.id}><option value={direct_choice.id}>{direct_choice.user} · {direct_choice.role}</option></each></select><div class="actions"><button type="button" on-click={grant_repository_developer} disabled={permission_user == ""}>Grant developer</button><button class="quiet" type="button" on-click={grant_repository_reporter} disabled={permission_user == ""}>Grant reporter</button><button class="danger" type="button" on-click={revoke_repository_permission} disabled={repository_grant == ""}>Revoke selected direct permission</button></div>
          <ul class="cards"><each items={dashboard.direct_permissions} as="permission" key={permission.id}><li><span class="badge">{permission.role}</span><strong>{permission.user}</strong><code>{permission.id}</code></li></each></ul>
          <h3>Fork repository</h3><p class="helper">Create an independent Git copy inside the current organization.</p><label for="fork-name">Fork name</label><input id="fork-name" maxlength="80" bind-value={fork_name}><button type="button" on-click={create_fork}>Create fork</button>
          <ul class="cards"><each items={dashboard.forks} as="fork_card" key={fork_card.id}><li><strong>{fork_card.repository}</strong><p>forked from {fork_card.parent}</p><code>{fork_card.id}</code></li></each></ul>
        </section></when>
      </route>
      <route path="/issues">
        <header class="page-heading"><div><p class="eyebrow">PLAN</p><h1>Issues and board</h1><p>Track work, discuss changes, and organize delivery without leaving the repository.</p></div><button class="quiet" type="button" on-click={load_issues} disabled={repository == ""}>Refresh issues</button></header>
        <section class="panel" aria-labelledby="issues-heading"><div class="section-heading"><div><h2 id="issues-heading">Issues</h2><p>Open new work or choose an existing issue to read and edit.</p></div><span class="count">{issue_total}</span></div>
          <div class="content-grid"><form class="stack" on-submit={create_issue}><label for="issue-title">New issue title</label><input id="issue-title" minlength="1" maxlength="160" required="true" bind-value={issue_title}><label for="issue-body">Description</label><textarea id="issue-body" maxlength="16000" bind-value={issue_body}></textarea><button type="submit" disabled={repository == ""}>Open issue</button></form><div><label for="issue-id">Selected issue</label><select id="issue-id" bind-value={issue}><option value="">Choose an issue</option><each items={issues.cards} as="issue_choice" key={issue_choice.id}><option value={issue_choice.id}>{issue_choice.title} · {issue_choice.state}</option></each></select><div class="actions"><button type="button" on-click={read_issue} disabled={issue == ""}>Open selected issue</button><button class="quiet" type="button" on-click={next_issues} disabled={issues.after == ""}>Next page</button></div></div></div>
          <p>{issue_total}</p><ul class="cards"><each items={issues.cards} as="issue_card" key={issue_card.id}><li><span class="badge">{issue_card.state}</span><strong>{issue_card.title}</strong><p>by {issue_card.author}</p><code>{issue_card.id}</code></li></each></ul>
          <when test={issue_detail.id != "" and issue_detail.id == issue}><article class="detail"><div class="section-heading"><div><h3>{issue_detail.title}</h3><p>{issue_detail.state} · opened by {issue_detail.author}</p></div><button class="danger" type="button" on-click={close_issue}>Close issue</button></div><p>{issue_detail.body}</p><form class="stack" on-submit={edit_issue}><label for="selected-issue-title">Edit title</label><input id="selected-issue-title" minlength="1" maxlength="160" required="true" bind-value={issue_title}><label for="selected-issue-body">Edit description</label><textarea id="selected-issue-body" maxlength="16000" bind-value={issue_body}></textarea><div class="actions"><button type="submit">Save changes</button><button class="quiet" type="button" on-click={reopen_issue}>Reopen issue</button></div></form></article>
          <h3>Discussion</h3><form class="stack" on-submit={add_comment}><label for="comment-body">Add a comment</label><textarea id="comment-body" maxlength="16000" required="true" bind-value={comment_body}></textarea><button type="submit">Comment</button></form><button class="quiet" type="button" on-click={load_comments}>Refresh comments</button><ol class="comments"><each items={issue_comments} as="comment" key={comment.id}><li><p>{comment.body}</p><p class="byline">{comment.author}</p></li></each></ol>
          <h3>Attachments</h3><label for="issue_attachment">Choose a file up to 8 MiB</label><input id="issue_attachment" type="file"><div class="actions"><button type="button" on-click={upload_attachment}>Upload file</button><button class="quiet" type="button" on-click={download_attachment}>Download current file</button><button class="danger" type="button" on-click={delete_attachment}>Delete current file</button></div><p role="status">{attachment_status}</p></when>
          <h3>Labels, milestones, and assignees</h3><div class="grid"><div><label for="milestone-title">Milestone</label><input id="milestone-title" maxlength="120" bind-value={milestone_title}></div><div><label for="milestone-due">Due</label><input id="milestone-due" maxlength="40" bind-value={milestone_due}></div><div><label for="label-name">New label name</label><input id="label-name" maxlength="60" bind-value={label_name}></div><div><label for="label-color">Six-digit hex label color</label><input id="label-color" maxlength="6" bind-value={label_color}></div><div><label for="label-picker">Label to apply</label><select id="label-picker" bind-value={label}><option value="">Choose a label</option><each items={dashboard.labels} as="label_choice" key={label_choice.id}><option value={label_choice.id}>{label_choice.name}</option></each></select></div><div><label for="assignee">Assignee user ID</label><input id="assignee" bind-value={assignee}></div></div>
          <div class="actions"><button on-click={create_milestone}>Create milestone</button><button on-click={create_label}>Create label</button><button on-click={label_issue} disabled={issue == "" or label == ""}>Apply selected label</button><button on-click={assign_issue} disabled={issue == "" or assignee == ""}>Assign selected issue</button><button on-click={reopen_issue} disabled={issue == ""}>Reopen issue</button></div>
          <ul class="cards"><each items={dashboard.milestones} as="milestone_card" key={milestone_card.id}><li><strong>{milestone_card.title}</strong><p>{milestone_card.due}</p><code>{milestone_card.id}</code></li></each></ul>
          <ul class="chips"><each items={dashboard.labels} as="label_card" key={label_card.id}><li><span class="badge">{label_card.name}</span></li></each></ul>
          <h3>Issue board</h3><div class="grid"><div><label for="board-column-title">New column title</label><input id="board-column-title" maxlength="80" bind-value={board_column_title}></div><div><label for="board-column-id">Destination column</label><select id="board-column-id" bind-value={board_column}><option value="">Choose a column</option><each items={dashboard.columns} as="column_choice" key={column_choice.id}><option value={column_choice.id}>{column_choice.title}</option></each></select></div></div><p class="helper">Choose an issue by title above, then add it or move it to the destination column.</p><div class="actions"><button type="button" on-click={create_board_column}>Create column</button><button type="button" on-click={add_board_card} disabled={issue == "" or board_column == ""}>Add selected issue</button><button class="quiet" type="button" on-click={move_board_card} disabled={issue == "" or board_column == ""}>Move selected issue</button><button class="quiet" type="button" on-click={refresh_collaboration}>Refresh board</button></div>
          <div class="board"><each items={dashboard.columns} as="column" key={column.id}><section><div class="section-heading"><h3>{column.title}</h3><span class="badge">Column {int_text(column.position)}</span></div><ul><each items={dashboard.cards} as="card" key={card.id}><when test={card.column == column.id}><li>Issue {text_slice(card.issue, 0, 8)}<span class="resource-id">Board position {int_text(card.position)}</span></li></when></each></ul></section></each></div>
        </section>
      </route>
      <route path="/merge-requests">
        <header class="page-heading"><div><p class="eyebrow">REVIEW</p><h1>Merge requests</h1><p>Every merge rechecks the reviewed objects, approvals, discussions, and protected branch policy.</p></div><button class="quiet" type="button" on-click={load_merge_requests} disabled={repository == ""}>Refresh merge requests</button></header>
        <section class="panel" aria-labelledby="merges-heading"><div class="section-heading"><div><h2 id="merges-heading">Review changes</h2><p>Open a request or choose an existing one to review.</p></div><span class="count">{merge_total}</span></div>
          <div class="content-grid"><form class="stack" on-submit={create_merge_request}><label for="merge-title">New request title</label><input id="merge-title" minlength="1" maxlength="160" required="true" bind-value={merge_title}><label for="merge-body">Description</label><textarea id="merge-body" maxlength="16000" bind-value={merge_body}></textarea><div class="grid"><div><label for="source-reference">Source branch</label><input id="source-reference" bind-value={source_reference}></div><div><label for="target-reference">Target branch</label><input id="target-reference" bind-value={target_reference}></div></div><button type="submit" disabled={repository == ""}>Open merge request</button></form><div><label for="merge-id">Selected merge request</label><select id="merge-id" bind-value={merge_request}><option value="">Choose a merge request</option><each items={merge_requests.cards} as="merge_choice" key={merge_choice.id}><option value={merge_choice.id}>{merge_choice.title} · {merge_choice.state}</option></each></select><div class="actions"><button type="button" on-click={read_merge_request} disabled={merge_request == ""}>Open selected request</button><button class="quiet" type="button" on-click={next_merge_requests} disabled={merge_requests.after == ""}>Next page</button></div></div></div>
          <p>{merge_total}</p><ul class="cards"><each items={merge_requests.cards} as="merge_card" key={merge_card.id}><li><span class="badge">{merge_card.state}</span><strong>{merge_card.title}</strong><p>{merge_card.source_reference} → {merge_card.target_reference} · {int_text(merge_card.approvals)} approvals</p><code>{merge_card.id}</code></li></each></ul>
          <when test={selected_merge.id != "" and selected_merge.id == merge_request}><article class="detail"><div class="section-heading"><div><h3>{selected_merge.title}</h3><p>{selected_merge.state} · {selected_merge.source_reference} → {selected_merge.target_reference}</p></div><span class="badge">{int_text(selected_merge.approvals)} approvals</span></div><p>Author {selected_merge.author} · strategy {selected_merge.strategy}</p><code>{selected_merge.source_object}</code><div class="actions"><button type="button" on-click={approve_merge_request}>Approve</button><button class="quiet" type="button" on-click={resolve_discussions}>Resolve all discussions</button><button type="button" on-click={merge_selected}>Merge reviewed changes</button><button class="danger" type="button" on-click={close_merge_request}>Close request</button></div></article>
          <h3>Merge strategy</h3><label for="merge-message">Commit message</label><input id="merge-message" maxlength="4096" bind-value={merge_message}><div class="actions"><button class="quiet" type="button" on-click={create_squash_merge_request}>Open as squash</button><button class="quiet" type="button" on-click={create_merge_commit_request}>Open as merge commit</button><button type="button" on-click={merge_squash}>Squash and merge</button><button type="button" on-click={merge_commit}>Create merge commit</button></div><p>Integrated object: <code>{integrated_object}</code></p>
          <h3>Review threads</h3><form class="stack" on-submit={add_review_thread}><label for="review-thread-body">Start a discussion</label><textarea id="review-thread-body" maxlength="16000" required="true" bind-value={review_thread_body}></textarea><button type="submit">Start thread</button></form><div class="grid"><div><label for="review-thread-id">Thread to resolve</label><select id="review-thread-id" bind-value={review_thread}><option value="">Choose a thread</option><each items={dashboard.threads} as="thread_choice" key={thread_choice.id}><option value={thread_choice.id}>{thread_choice.body}</option></each></select></div><div><label for="review-id">Approval to dismiss</label><select id="review-id" bind-value={review_id}><option value="">Choose an approval</option><each items={dashboard.reviews} as="review_choice" key={review_choice.id}><option value={review_choice.id}>{review_choice.reviewer}</option></each></select></div></div><div class="actions"><button type="button" on-click={resolve_review_thread} disabled={review_thread == ""}>Resolve selected thread</button><button class="danger" type="button" on-click={dismiss_approval} disabled={review_id == ""}>Dismiss selected approval</button><button class="quiet" type="button" on-click={refresh_collaboration}>Refresh review</button></div>
          <ol class="comments"><each items={dashboard.threads} as="thread" key={thread.id}><li><span class="badge">{thread.resolved}</span><p>{thread.body}</p><p class="byline">{thread.author} · MR {thread.merge_request}</p><code>{thread.id}</code></li></each></ol>
          <h3>Approvals</h3><ul class="cards"><each items={dashboard.reviews} as="review" key={review.id}><li><strong>{review.reviewer}</strong><p>MR {review.merge_request}</p><code>{review.id}</code></li></each></ul></when>
        </section>
      </route>
      <route path="/knowledge">
        <header class="page-heading"><div><p class="eyebrow">DOCUMENT</p><h1>Wiki and snippets</h1><p>Keep project knowledge and reusable code close to the repository.</p></div><button class="quiet" type="button" on-click={refresh_collaboration} disabled={repository == ""}>Refresh content</button></header>
        <section class="panel" aria-labelledby="knowledge-heading"><h2 id="knowledge-heading">Wiki pages</h2>
          <h3>Create or update a page</h3><div class="grid"><div><label for="wiki-slug">URL slug</label><input id="wiki-slug" maxlength="120" bind-value={wiki_slug}></div><div><label for="wiki-page-id">Page to update</label><select id="wiki-page-id" bind-value={wiki_page}><option value="">Create a new page</option><each items={dashboard.wiki} as="wiki_choice" key={wiki_choice.id}><option value={wiki_choice.id}>{wiki_choice.title} · revision {int_text(wiki_choice.revision)}</option></each></select></div></div><label for="wiki-title">Title</label><input id="wiki-title" maxlength="160" bind-value={wiki_title}><label for="wiki-body">Content</label><textarea id="wiki-body" maxlength="16000" bind-value={wiki_body}></textarea><div class="actions"><button type="button" on-click={create_wiki_page} disabled={repository == ""}>Create page</button><button class="secondary" type="button" on-click={update_wiki_page} disabled={wiki_page == ""}>Save new revision</button></div>
          <ul class="cards"><each items={dashboard.wiki} as="page" key={page.id}><li><strong>{page.title}</strong><span class="badge">revision {int_text(page.revision)}</span><p>{page.body}</p><code>{page.slug} · {page.id}</code></li></each></ul>
          <h3>New snippet</h3><div class="grid"><div><label for="snippet-title">Title</label><input id="snippet-title" maxlength="160" bind-value={snippet_title}></div><div><label for="snippet-filename">Filename</label><input id="snippet-filename" maxlength="255" bind-value={snippet_filename}></div></div><label for="snippet-body">Code or text</label><textarea id="snippet-body" maxlength="16000" bind-value={snippet_body}></textarea><button type="button" on-click={create_snippet} disabled={repository == ""}>Create snippet</button>
          <ul class="cards"><each items={dashboard.snippets} as="snippet_card" key={snippet_card.id}><li><strong>{snippet_card.title}</strong><code>{snippet_card.filename}</code><pre>{snippet_card.body}</pre></li></each></ul>
        </section>
      </route>
      <route path="/delivery">
        <header class="page-heading"><div><p class="eyebrow">AUTOMATE</p><h1>CI/CD</h1><p>Pipelines run an exact Git commit without network access inside the bounded native sandbox.</p></div><button class="quiet" type="button" on-click={refresh_delivery} disabled={repository == ""}>Refresh delivery</button></header>
        <section class="panel" aria-labelledby="delivery-heading"><h2 id="delivery-heading">Pipelines, artifacts, registry, and Pages</h2><p>Configuration comes from <code>.diamond-ci.json</code> at the selected ref.</p>
          <div class="grid"><div><label for="pipeline-reference">Git branch, tag, or commit</label><input id="pipeline-reference" bind-value={pipeline_reference}></div><div><label for="pipeline-event">Unique run key</label><input id="pipeline-event" maxlength="128" aria-describedby="pipeline-event-help" bind-value={pipeline_event}><p id="pipeline-event-help" class="field-help">Use a new value for each intentional run.</p></div><div><label for="pipeline-id">Selected pipeline</label><select id="pipeline-id" bind-value={pipeline}><option value="">Choose a pipeline</option><each items={pipelines.cards} as="pipeline_choice" key={pipeline_choice.id}><option value={pipeline_choice.id}>{pipeline_choice.reference} · {pipeline_choice.state}</option></each></select></div></div>
          <div class="actions"><button type="button" on-click={schedule_pipeline} disabled={repository == ""}>Run pipeline</button><button class="quiet" type="button" on-click={refresh_delivery} disabled={pipeline == ""}>Load selected pipeline</button><button class="danger" type="button" on-click={cancel_pipeline} disabled={pipeline == ""}>Cancel selected pipeline</button></div>
          <h3>Pipelines</h3><ul class="cards"><each items={pipelines.cards} as="item" key={item.id}><li><span class="badge">{item.state}</span><strong>{item.reference}</strong><p>{item.created}</p><code>{item.id} · {item.commit}</code></li></each></ul>
          <h3>Jobs</h3><ol class="commits"><each items={pipeline_jobs.cards} as="job" key={job.id}><li><span class="badge">{job.state}</span><strong>{job.name}</strong><p>attempts {job.attempts}</p><pre>{job.log}</pre><code>{job.id}</code></li></each></ol>
          <h3>Artifacts</h3><p>Downloads support resumable byte ranges and content validation.</p><ul class="cards"><each items={pipeline_artifacts.cards} as="item" key={item.id}><li><strong>{item.name}</strong><p>{item.size} bytes</p><code>{item.digest}</code></li></each></ul><label for="artifact-id">Artifact to remove</label><select id="artifact-id" bind-value={artifact_id}><option value="">Choose an artifact</option><each items={pipeline_artifacts.cards} as="artifact_choice" key={artifact_choice.id}><option value={artifact_choice.id}>{artifact_choice.name} · {artifact_choice.size} bytes</option></each></select><button class="danger" type="button" on-click={delete_delivery_artifact} disabled={artifact_id == ""} aria-controls="delivery-status">Delete selected artifact metadata</button>
          <h3>OCI images</h3><ul class="cards"><each items={pipeline_images.cards} as="item" key={item.digest}><li><span class="badge">{item.tag}</span><strong>{item.name}</strong><code>{item.digest}</code></li></each></ul>
          <h3>Pages and environments</h3><ul class="cards"><each items={pipeline_pages.cards} as="item" key={item.site}><li><strong>{item.site}</strong><code>{item.deployment}</code></li></each></ul><div class="grid"><div><label for="page-site">Pages site</label><input id="page-site" bind-value={page_site}></div><div><label for="page-deployment">Deployment to activate</label><select id="page-deployment" bind-value={page_deployment}><option value="">Choose a deployment</option><each items={pipeline_pages.cards} as="page_choice" key={page_choice.deployment}><option value={page_choice.deployment}>{page_choice.site} · {page_choice.deployment}</option></each></select></div><div><label for="page-domain">Custom domain</label><input id="page-domain" bind-value={page_domain}></div></div><div class="actions"><button type="button" on-click={activate_pages_deployment} disabled={page_deployment == ""}>Activate deployment</button><button class="quiet" type="button" on-click={set_pages_domain}>Map custom domain</button><button class="danger" type="button" on-click={remove_pages_domain}>Remove custom domain</button></div><ul class="cards"><each items={page_domains.cards} as="domain" key={domain.domain}><li><strong>{domain.domain}</strong><code>site {domain.site}</code></li></each></ul><ul class="cards"><each items={pipeline_environments.cards} as="item" key={item.name}><li><span class="badge">{item.state}</span><strong>{item.name}</strong><p>pipeline {item.pipeline}</p><code>{item.deployment}</code></li></each></ul><label for="environment-name">Environment to stop</label><select id="environment-name" bind-value={environment_name}><option value="">Choose an environment</option><each items={pipeline_environments.cards} as="environment_choice" key={environment_choice.name}><option value={environment_choice.name}>{environment_choice.name} · {environment_choice.state}</option></each></select><button class="danger" type="button" on-click={stop_delivery_environment} disabled={environment_name == ""}>Stop selected environment</button><p id="delivery-status" role="status" aria-live="polite">{output}</p>
        </section>
      </route>
      <route path="/operations">
        <header class="page-heading"><div><p class="eyebrow">ADMINISTER</p><h1>Operations</h1><p>Advanced tools for placement, recovery, retention, and runtime policy.</p></div></header><when test={repository == ""}><p class="empty-state page-empty">Choose and open a repository before using repository-scoped operations.</p></when><when test={repository != ""}><use component="OperationsConsole" repository={repository}></use></when>
      </route>
      <route path="/releases">
        <header class="page-heading"><div><p class="eyebrow">PUBLISH</p><h1>Releases</h1><p>Package a Git tag with notes and bounded release assets.</p></div><button class="quiet" type="button" on-click={refresh_collaboration} disabled={repository == ""}>Refresh releases</button></header>
        <section class="panel" aria-labelledby="releases-heading"><h2 id="releases-heading">Create a release</h2><p>Release tags must resolve to a commit. Large working-tree objects use the standard Git LFS endpoint.</p>
          <div class="grid"><div><label for="release-tag">Git tag or ref</label><input id="release-tag" maxlength="120" bind-value={release_tag}></div><div><label for="release-name">Release name</label><input id="release-name" maxlength="160" bind-value={release_name}></div><div><label for="release-id">Selected release</label><select id="release-id" bind-value={release}><option value="">Choose a release</option><each items={dashboard.releases} as="release_choice" key={release_choice.id}><option value={release_choice.id}>{release_choice.name} · {release_choice.tag}</option></each></select></div></div><label for="release-notes">Release notes</label><textarea id="release-notes" maxlength="16000" bind-value={release_notes}></textarea><label class="check"><input id="release-draft" type="checkbox" bind-checked={release_draft}> Save as draft</label><div class="actions"><button type="button" on-click={create_release} disabled={repository == ""}>Create release</button></div>
          <ul class="cards"><each items={dashboard.releases} as="release_card" key={release_card.id}><li><span class="badge">{release_card.tag}</span><strong>{release_card.name}</strong><p>{release_card.notes}</p><code>{release_card.id}</code></li></each></ul>
          <h3>Release asset</h3><p class="helper">Choose a release above, then attach a file up to 8 MiB.</p><label for="release_asset_file">Asset file</label><input id="release_asset_file" type="file"><div class="actions"><button type="button" on-click={upload_release_asset} disabled={release == ""}>Upload asset</button><button class="quiet" type="button" on-click={download_release_asset}>Download current asset</button><button class="danger" type="button" on-click={delete_release_asset}>Delete current asset</button></div><p role="status">{release_asset_status}</p>
          <h3>Git LFS client configuration</h3><pre>git lfs install; git lfs track "*.bin"; git add .gitattributes your-file.bin; git commit; git push</pre>
        </section>
      </route>
      <route path="/activity">
        <header class="page-heading"><div><p class="eyebrow">STAY INFORMED</p><h1>Activity</h1><p>See repository notifications and the administrative audit trail.</p></div><button class="quiet" type="button" on-click={refresh_collaboration} disabled={repository == ""}>Refresh activity</button></header>
        <section class="panel" aria-labelledby="activity-heading"><h2 id="activity-heading">Notifications and audit trail</h2><fieldset><legend>What to show</legend><label class="check"><input type="checkbox" bind-checked={notifications_enabled}> Repository notifications</label><label class="check"><input type="checkbox" bind-checked={notifications_unread_only}> Unread only</label><div class="actions"><button type="button" on-click={save_notification_preferences}>Save preferences</button><button class="quiet" type="button" on-click={load_notification_preferences}>Reset to saved</button></div></fieldset><label for="notification-id">Notification</label><select id="notification-id" bind-value={notification}><option value="">Choose a notification</option><each items={dashboard.notifications} as="notification_choice" key={notification_choice.id}><option value={notification_choice.id}>{notification_choice.message}</option></each></select><button type="button" on-click={mark_notification_read} disabled={notification == ""}>Mark selected notification read</button>
          <h3>Notifications</h3><ul class="cards"><each items={dashboard.notifications} as="notice" key={notice.id}><li><span class="badge">{notice.kind}</span><strong>{notice.message}</strong><p>repository {notice.repository}</p><code>{notice.id}</code></li></each></ul>
          <h3>Administrative audit</h3><ol class="commits"><each items={dashboard.audit} as="audit" key={audit.id}><li><strong>{audit.action}</strong><p>{audit.subject}</p><p class="byline">actor {audit.actor}</p><code>{audit.id}</code></li></each></ol>
        </section>
      </route>
      <route path="/settings">
        <header class="page-heading"><div><p class="eyebrow">CONFIGURE</p><h1>Repository settings</h1><p>Security-sensitive controls are grouped here and name the resource they change.</p></div></header>
        <section class="panel" aria-labelledby="settings-heading"><h2 id="settings-heading">Security and automation</h2><p>These controls require an account administrator except normal merge-request approval.</p>
          <label for="protected-reference">Branch ref</label><input id="protected-reference" bind-value={protected_reference}><div class="actions"><button type="button" on-click={protect_main}>Require approval and resolved discussions</button><button class="danger" type="button" on-click={unprotect_main}>Remove protection from this branch</button></div>
          <h3>Deploy keys</h3><label for="deploy-label">Key label</label><input id="deploy-label" bind-value={deploy_label}><label for="deploy-key">Ed25519 public key</label><textarea id="deploy-key" bind-value={deploy_key}></textarea><button type="button" on-click={add_deploy_key}>Add read-only deploy key</button><label for="deploy-id">Key ID to revoke</label><input id="deploy-id" bind-value={deploy_id}><button class="danger" type="button" on-click={revoke_deploy_key} disabled={deploy_id == ""}>Revoke selected key</button>
          <h3>Durable push events</h3><button class="quiet" type="button" on-click={load_push_events}>Load pending events</button><pre>{push_events}</pre><label for="push-event-id">Event ID to acknowledge</label><input id="push-event-id" bind-value={push_event_id}><button type="button" on-click={acknowledge_push_event} disabled={push_event_id == ""}>Acknowledge selected event</button>
          <h3>Webhooks</h3><p>Administrators bind the destination origin. Repository users can choose only an allowed path on that origin.</p><div class="grid"><div><label for="webhook-path">Destination path</label><input id="webhook-path" maxlength="120" bind-value={webhook_path}></div><div><label for="webhook-id">Webhook</label><select id="webhook-id" bind-value={webhook}><option value="">Choose a webhook</option><each items={dashboard.webhooks} as="webhook_choice" key={webhook_choice.id}><option value={webhook_choice.id}>{webhook_choice.path}</option></each></select></div><div><label for="webhook-event">Unique test event ID</label><input id="webhook-event" maxlength="128" bind-value={webhook_event}></div></div><label for="webhook-payload">JSON test payload</label><textarea id="webhook-payload" maxlength="16000" bind-value={webhook_payload}></textarea><div class="actions"><button type="button" on-click={create_webhook}>Create webhook</button><button class="secondary" type="button" on-click={test_webhook} disabled={webhook == ""}>Send test event</button><button class="quiet" type="button" on-click={refresh_collaboration}>Refresh webhooks</button></div><ul class="cards"><each items={dashboard.webhooks} as="hook" key={hook.id}><li><span class="badge">{hook.active}</span><strong>{hook.path}</strong><code>{hook.id}</code></li></each></ul>
        </section>
      </route>
        </div>
        <when test={repository != ""}><div class="activity" aria-live="polite"><div><span class="status-dot"></span><strong>Live repository activity</strong></div><p>{activity}</p></div></when>
      </when>
    </main>
