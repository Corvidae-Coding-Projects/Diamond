export component GitBrowser:
  state username: Text = ""
  state password: Text = ""
  state signed_in: Text = ""
  state label: Text = "example"
  state repository: Text = ""
  state current: GitHead = GitHead(reference: "", object: None)
  state credential: Text = ""
  state ssh_label: Text = "workstation"
  state ssh_key: Text = ""
  state reference: Text = "refs/heads/main"
  state deploy_label: Text = "automation"
  state deploy_key: Text = ""
  state deploy_id: Text = ""
  state certificate_principal: Text = ""
  state certificate_id: Text = ""
  state push_events: Text = ""
  state push_event_id: Text = ""
  state output: Text = "Sign in and register a repository."

  on sign_in:
    signed_in = session.login(username, password)
    password = ""
    output = "Signed in."
  on sign_out:
    signed_in = session.logout()
    repository = ""
    credential = ""
    output = "Signed out."
  on google_login:
    output = session.oauth_login("google", "")
  on github_login:
    output = session.oauth_login("github", "")
  on register:
    repository = rpc.register_repository(label, true)
    output = "Repository metadata registered."
  on initialize:
    output = rpc.initialize_repository(repository)
  on head:
    current = rpc.repository_head(repository)
    output = current.reference
  on create_credential:
    credential = session.create_token("Git client", ["git:repos:read", "git:repos:write"], "{\"repository\":[\"" + repository + "\"]}", 3600)
    output = "Copy the credential now; it is shown only once."
  on add_ssh_key:
    output = session.add_ssh_key(ssh_label, ssh_key)
    ssh_key = ""
  on protect:
    output = rpc.protect_reference(repository, reference, "authenticated", false, false, 1, true, true, true, true)
  on unprotect:
    output = rpc.unprotect_reference(repository, reference)
  on add_deploy_key:
    deploy_id = rpc.add_deploy_key(repository, deploy_label, deploy_key, false)
    deploy_key = ""
    output = "Read-only deploy key added."
  on revoke_deploy_key:
    output = rpc.revoke_deploy_key(repository, deploy_id)
  on add_certificate:
    certificate_id = rpc.add_certificate(repository, certificate_principal, false)
    output = "Read-only SSH certificate principal added."
  on revoke_certificate:
    output = rpc.revoke_certificate(repository, certificate_id)
  on load_push_events:
    push_events = rpc.pending_push_events(100)
  on acknowledge_push_event:
    output = rpc.acknowledge_push_event(push_event_id)

  html:
    <main>
      <h1>Diamond Git browser</h1>
      <section>
        <h2>Account</h2>
        <label for="username">Username</label><input id="username" bind-value={username}>
        <label for="password">Password</label><input id="password" type="password" bind-value={password}>
        <button on-click={sign_in}>Sign in</button>
        <button on-click={google_login}>Continue with Google</button>
        <button on-click={github_login}>Continue with GitHub</button>
        <button on-click={sign_out}>Sign out</button>
        <p>{signed_in}</p>
      </section>
      <section>
        <h2>Repository</h2>
        <label for="label">Name</label><input id="label" bind-value={label}>
        <button on-click={register}>Register</button>
        <button on-click={initialize}>Initialize Git</button>
        <button on-click={head}>Read HEAD</button>
        <button on-click={create_credential}>Create one-hour Git credential</button>
        <label for="reference">Protected ref</label><input id="reference" bind-value={reference}>
        <button on-click={protect}>Protect ref</button>
        <button on-click={unprotect}>Remove protection</button>
        <label for="ssh-label">SSH key label</label><input id="ssh-label" bind-value={ssh_label}>
        <label for="ssh-key">Ed25519 public key</label><textarea id="ssh-key" bind-value={ssh_key}></textarea>
        <button on-click={add_ssh_key}>Add SSH key</button>
        <label for="deploy-label">Deploy key label</label><input id="deploy-label" bind-value={deploy_label}>
        <label for="deploy-key">Deploy Ed25519 public key</label><textarea id="deploy-key" bind-value={deploy_key}></textarea>
        <button on-click={add_deploy_key}>Add read-only deploy key</button>
        <label for="deploy-id">Deploy key ID</label><input id="deploy-id" bind-value={deploy_id}>
        <button on-click={revoke_deploy_key}>Revoke deploy key</button>
        <label for="certificate-principal">SSH certificate principal</label><input id="certificate-principal" bind-value={certificate_principal}>
        <button on-click={add_certificate}>Add read-only certificate principal</button>
        <label for="certificate-id">Certificate principal ID</label><input id="certificate-id" bind-value={certificate_id}>
        <button on-click={revoke_certificate}>Revoke certificate principal</button>
        <button on-click={load_push_events}>Load pending push events</button>
        <label for="push-event-id">Push event ID</label><input id="push-event-id" bind-value={push_event_id}>
        <button on-click={acknowledge_push_event}>Acknowledge push event</button>
        <p>Repository ID: {repository}</p>
        <p>Git username: diamond</p>
        <pre>{credential}</pre>
        <pre>{push_events}</pre>
        <pre>{output}</pre>
      </section>
    </main>
